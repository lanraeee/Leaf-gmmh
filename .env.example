# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get from: https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="https://your-project.vercel.app"

# ─── Azure AD (HSE SSO) ───────────────────────────────────────────────────────
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ─── PARIS Integration ────────────────────────────────────────────────────────
# Leave blank to use the local patient directory (stub mode)
# Set to PARIS API base URL when HSE IT provisions access — no code changes needed
PARIS_API_URL=""
PARIS_API_KEY=""

# ─── InPhase Integration ──────────────────────────────────────────────────────
# Leave blank to log incidents locally (stub mode)
# Set to InPhase API base URL when provisioned — AWOL events auto-file incidents
INPHASE_API_URL=""
INPHASE_API_KEY=""
INPHASE_ORG_CODE=""

# ─── Push Notifications (Web Push / VAPID) ────────────────────────────────────
# Generate VAPID keys with: npx web-push generate-vapid-keys
# Both keys must be set to enable push notifications to mobile/tablet
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT_EMAIL="admin@your-domain.ie"

# ─── Email Notifications (Resend) ────────────────────────────────────────────
# Get API key from: https://resend.com/api-keys
# Set EMAIL_FROM to a verified domain sender
RESEND_API_KEY=""
EMAIL_FROM="PLDS Alerts <alerts@your-domain.ie>"

# ─── Vercel Blob (audio recordings + patient photos) ──────────────────────────
# Auto-provisioned by Vercel when you add a Blob store in the dashboard
# vercel env pull will populate this automatically
BLOB_READ_WRITE_TOKEN=""
